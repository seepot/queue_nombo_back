# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL Multi-Tenant - QueNombo)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/quenombo?schema=public&connection_limit=20&pool_timeout=30"

# -----------------------------------------------------------------------------
# REDIS (Pub/Sub, Live Sequences & TV Device Pairing PINs)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth v5)
# -----------------------------------------------------------------------------
AUTH_SECRET="generate-a-random-32-character-secret-key-here"
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# APPLICATION CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="QueNombo - Sistem Pengurusan Giliran SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Domain induk untuk subdomain tenant (cth: quenombo.com -> klinik-a.quenombo.com). Kosong = matikan.
# Dalam pembangunan, <slug>.localhost sentiasa disokong.
NEXT_PUBLIC_APP_DOMAIN=""

# -----------------------------------------------------------------------------
# REALTIME WEBSOCKET SERVICE (NestJS Gateway)
# -----------------------------------------------------------------------------
REALTIME_SERVICE_URL="http://localhost:4001"
REALTIME_SERVICE_SECRET="generate-a-random-secret"

# -----------------------------------------------------------------------------
# BILLING & PAYMENT GATEWAY
# -----------------------------------------------------------------------------
# Rahsia untuk webhook simulasi / manual (header: x-billing-secret). Wajib di produksi.
BILLING_WEBHOOK_SECRET="generate-a-random-secret"
# Benarkan kaedah bayaran "SANDBOX" (aktif serta-merta tanpa bayaran). Lalai: true di luar produksi.
BILLING_SANDBOX_ENABLED="true"
# ToyyibPay (FPX / Kad). Guna https://dev.toyyibpay.com untuk sandbox.
TOYYIBPAY_SECRET_KEY=""
TOYYIBPAY_CATEGORY_CODE=""
TOYYIBPAY_BASE_URL="https://toyyibpay.com"

# -----------------------------------------------------------------------------
# E-MEL (tetapan semula kata laluan & pengesahan e-mel pendaftaran).
# Tanpa RESEND_API_KEY, pautan dicatat ke konsol dan dipulangkan sebagai devResetUrl / devVerifyUrl (dev sahaja).
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="QueNombo <no-reply@quenombo.com>"
# Ujian automatik sahaja: dalam mod konsol (tanpa RESEND_API_KEY), salin setiap e-mel ke fail ini (JSON setiap baris).
# MAIL_OUTBOX_FILE=".mail-outbox.jsonl"

# -----------------------------------------------------------------------------
# CRON (sapuan status langganan harian: GET /api/cron/subscriptions)
# Vercel Cron menghantar "Authorization: Bearer <CRON_SECRET>" secara automatik.
# -----------------------------------------------------------------------------
CRON_SECRET="generate-a-random-secret"
