generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  nokp        String?   @db.VarChar(20)
  nama        String?   @db.VarChar(200)
  uname       String?   @db.VarChar(20)
  pass        String?   @db.VarChar(200)
  levelAkses  Int?      @map("level_akses")
  idCawangan  String?   @map("id_cawangan") @db.VarChar(10)
  last_login  DateTime? @db.DateTime(0)
  catatan     String?   @db.VarChar(20)
  statusLogin Int?      @map("status_login")

  @@index([idCawangan], map: "id_cawangan")
  @@map("users")
}

model Cawangan {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  idCawangan       String?   @map("id_cawangan") @db.VarChar(20)
  namaCawangan     String    @map("nama_cawangan") @db.VarChar(200)
  alamat1          String?   @db.VarChar(255)
  alamat2          String?   @db.VarChar(255)
  alamat3          String?   @db.VarChar(255)
  alamat4          String?   @db.VarChar(200)
  noTelefon        String?   @map("no_telefon") @db.VarChar(20)
  no_faks          String?   @db.VarChar(20)
  negeri           String?   @db.VarChar(10)
  daerah           String?   @db.VarChar(10)
  bil_kaunter      Int?
  player_id        String?   @db.VarChar(200)
  create_date      DateTime? @db.DateTime(0)
  latitud          String?   @db.VarChar(50)
  longitud         String?   @db.VarChar(50)
  update_date      DateTime? @db.DateTime(0)
  update_by        String?   @db.VarChar(20)
  sela_masa        Int?
  flag             String?   @db.VarChar(5)
  jenis_limit      Int?
  tempoh_mula_scan Int?
  status_eq        Int?      @default(0)
  radius           Int?
  kodQR            String?   @db.VarChar(200)
  tarikh_jana      DateTime? @db.DateTime(0)
  nama_qr          String?   @db.VarChar(250)
  gambar_qr        String?   @db.Text

  @@map("cawangan")
}

model Perkhidmatan {
  id         Int     @id @default(autoincrement()) @db.UnsignedInt
  keterangan String? @db.VarChar(500)

  @@map("perkhidmatan")
}

model KumpulanPerkhidmatan {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  idPerkhidmatan String?   @map("id_perkhidmatan") @db.Text
  idCawangan     String?   @map("id_cawangan") @db.VarChar(20)
  keterangan     String?   @db.VarChar(255)
  noSiri         Int       @map("no_siri")
  noTerkini      Int       @map("no_terkini")
  kategori       Int       @default(1)
  isPelbagai     Int?      @default(0) @map("ispelbagai")
  createDate     DateTime? @map("create_date") @db.DateTime(0)
  status         Int?      @default(1)

  @@index([idCawangan], map: "id_cawangan")
  @@map("kumpulan_perkhidmatan")
}

model Kaunter {
  id                     Int       @id @default(autoincrement()) @db.UnsignedInt
  noKaunter              String?   @map("no_kaunter") @db.VarChar(11)
  namaKaunter            String?   @map("nama_kaunter") @db.VarChar(100)
  idPerkhidmatanKumpulan Int?      @map("id_perkhidmatan_kumpulan")
  idCawangan             String?   @map("id_cawangan") @db.VarChar(20)
  noSiri                 Int?      @map("no_siri")
  susunanKeutamaan       String?   @map("susunan_keutamaan") @db.VarChar(35)
  idPengguna             String?   @map("id_pengguna") @db.VarChar(11)
  transid                String?   @db.VarChar(20)
  no_tiket               Int?
  masa_panggil           DateTime? @db.DateTime(0)
  masa_selesai           DateTime? @db.DateTime(0)
  masa_batal             DateTime? @db.DateTime(0)
  bilangan_pelanggan     Int?
  masa_menunggu          DateTime? @db.Time(0)
  waktuMula              DateTime? @map("waktu_mula") @db.DateTime(0)
  zon                    String?   @db.VarChar(25)

  @@map("kaunter")
}

model Zon {
  id       Int    @id @default(autoincrement())
  cawangan String @db.VarChar(10)
  zon      String @db.VarChar(25)
  catatan  String @db.VarChar(50)

  @@map("zon")
}

model JadualTugasan {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  nokp         String?   @db.VarChar(20)
  idKaunter    Int?      @map("id_kaunter")
  id_cawangan  String?   @db.VarChar(10)
  tarikh_mula  DateTime? @db.Date
  tarikh_tamat DateTime? @db.Date
  status_aktif Int?      @default(1)
  create_date  DateTime? @db.DateTime(0)
  update_date  DateTime  @default(now()) @db.Timestamp(0)

  @@map("jadual_tugasan")
}

model TempahanTarikh {
  id               Int     @id @default(autoincrement())
  cawangan         String? @db.VarChar(100)
  kumpPerkhidmatan String? @map("kump_perkhidmatan") @db.VarChar(20)
  hadMax           String? @map("had_max") @db.VarChar(5)
  tarikh           String? @db.VarChar(20)
  status           Int?    @default(0)
  cttmBatal        String? @map("cttn_batal") @db.Text
  nyahaktif        Int?
  buka_tempahan    Int?

  @@index([cawangan], map: "cawangan")
  @@index([kumpPerkhidmatan], map: "kump_perkhidmatan")
  @@map("tempahan_tarikh")
}

model TempahanMasa {
  id               Int     @id @default(autoincrement())
  cawangan         String? @db.VarChar(200)
  kumpPerkhidmatan String? @map("kump_perkhidmatan") @db.VarChar(30)
  tarikh           String? @db.VarChar(30)
  masa             String? @db.VarChar(30)
  bilangan         Int?
  status           Int?
  bilTlhIsi        Int?    @default(0) @map("bil_tlh_isi")
  buka_tempahan    Int?

  @@index([cawangan], map: "cawangan")
  @@index([kumpPerkhidmatan], map: "kump_perkhidmatan")
  @@map("tempahan_masa")
}

model TempahanList {
  id              Int       @id @default(autoincrement())
  tempahanMasaId  Int?      @map("tempahan_masa_id")
  cawangan        String?   @db.VarChar(100)
  urusniaga       Int?
  kategori        Int?
  nopengenalan    String?   @db.VarChar(20)
  nama            String?   @db.VarChar(200)
  notelefon       String?   @db.VarChar(20)
  emel            String?   @db.VarChar(50)
