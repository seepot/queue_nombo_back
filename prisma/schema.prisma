  tujuanTransaksi String?   @map("tujuan_transaksi") @db.VarChar(255)
  webToken        String?   @map("web_token") @db.VarChar(100)
  firstId         Int?      @map("first_id")
  firstMasaId     Int?      @map("first_masa_id")
  tempId          Int?      @map("temp_id")

  @@index([cawangan], map: "cawangan")
  @@index([kategori], map: "kategori")
  @@index([nopengenalan], map: "nopengenalan")
  @@index([tempahanMasaId], map: "tempahan_masa_id")
  @@map("tempahan_list")
}

model TempahanBatal {
  id              Int       @id @default(autoincrement())
  idTempahan      Int?      @map("id_tempahan")
  tempahanMasaId  Int?      @map("tempahan_masa_id")
  cawangan        String?   @db.VarChar(100)
  urusniaga       Int?
  kategori        Int?
  nopengenalan    String?   @db.VarChar(20)
  nama            String?   @db.VarChar(200)
  notelefon       String?   @db.VarChar(20)
  emel            String?   @db.VarChar(50)
  playerId        String?   @map("player_id") @db.VarChar(100)
  hash            String?   @db.VarChar(100)
