datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN      // Pemilik platform SaaS (Level 1)
  TENANT_ADMIN    // Pentadbir Syarikat / Organisasi (Level 2)
  BRANCH_MANAGER  // Pengurus Cawangan (Level 3)
  COUNTER_STAFF   // Staf Kaunter (Level 4)
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TicketStatus {
  WAITING     // 0: Menunggu dalam barisan
  CALLING     // 1: Sedang dipanggil di skrin TV / kaunter
  SERVING     // 2: Sedang dilayan di kaunter
  RECALLED    // 3: Panggilan semula
  TRANSFERRED // 4: Dipindahkan ke kaunter/kategori lain
  COMPLETED   // 5: Selesai urusan
  NO_SHOW     // 6: Tidak hadir selepas dipanggil
  CANCELLED   // 7: Dibatalkan (oleh staf atau pelanggan)
}

enum CounterStatus {
  OPEN
  CLOSED
  PAUSED
}

// -----------------------------------------------------------------------------
// 2. TENANT & SUBSCRIPTION (MULTI-TENANCY CORE)
// -----------------------------------------------------------------------------

model Tenant {
  id            String         @id @default(uuid())
  name          String         // Cth: "Klinik Pakar Dr. Azman"
  slug          String         @unique // Cth: "dr-azman" -> dr-azman.smartq.com
  email         String?
  phone         String?
  planType      PlanType       @default(FREE)
  status        String         @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  settings      Json?          // Branding: logo, warna tema, video promo URL, waktu operasi default
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  users         User[]
  branches      Branch[]
  subscriptions Subscription[]
  transactions  PaymentTransaction[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model Subscription {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planType        PlanType           @default(FREE) @map("plan_type")
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime           @default(now()) @map("start_date")
  endDate         DateTime?          @map("end_date")
  maxBranches     Int                @default(1) @map("max_branches")
  maxCounters     Int                @default(2) @map("max_counters")
  maxDisplays     Int                @default(1) @map("max_displays")
  whatsappQuota   Int                @default(0) @map("whatsapp_quota")
  whatsappUsed    Int                @default(0) @map("whatsapp_used")
  billingCycle    String             @default("MONTHLY") @map("billing_cycle") // MONTHLY, YEARLY
  paymentProvider String?            @map("payment_provider") // STRIPE, BILLPLZ, TOYYIBPAY
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  transactions    PaymentTransaction[]

  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// 3. PENGGUNA & KESELAMATAN
// -----------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  tenantId      String?    @map("tenant_id")
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?    @map("branch_id")
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  username      String     @unique
  email         String?    @unique
  name          String
  passwordHash  String     @map("password_hash") // Bcrypt hash
  role          UserRole   @default(COUNTER_STAFF)
  phone         String?
  status        String     @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  emailVerifiedAt DateTime? @map("email_verified_at") // null = e-mel belum disahkan
  lastLogin     DateTime?  @map("last_login")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  counters      Counter[]  @relation("CounterStaff")
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@index([branchId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 4. CAWANGAN & KONFIGURASI PREMIS
// -----------------------------------------------------------------------------

model Branch {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String            // Cth: "Cawangan Shah Alam"
  code        String            // Cth: "SA01"
  address     String?
  city        String?
  state       String?
  postcode    String?
  phone       String?
  latitude    Float?
  longitude   Float?
  qrRadiusMeters Int?           @default(500) @map("qr_radius_meters")
  qrCodeUrl   String?           @map("qr_code_url")
  settings    Json?             // Waktu rehat, hari operasi, teks notis
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  users        User[]
  categories   ServiceCategory[]
  counters     Counter[]
  devices      Device[]
  tickets      Ticket[]
  schedules    StaffSchedule[]
  appointments Appointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model ServiceCategory {
  id               String   @id @default(uuid())
  branchId         String   @map("branch_id")
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name             String   // Cth: "Pembayaran & Zakat"
  prefixCode       String   @map("prefix_code") // Cth: "A", "B", "K"
  startNumber      Int      @default(1001) @map("start_number")
  currentSeq       Int      @default(1000) @map("current_seq")
  estimatedMinutes Int      @default(5) @map("estimated_minutes")
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE
  sortOrder        Int      @default(1) @map("sort_order")
  nextCategoryId   String?  @map("next_category_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tickets          Ticket[]
  appointments     Appointment[]

  @@index([branchId])
  @@map("service_categories")
}

model Counter {
  id              String        @id @default(uuid())
  branchId        String        @map("branch_id")
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counterNo       String        @map("counter_no") // Cth: "1", "2", "Bilik Rawatan 1"
  name            String?       // Cth: "Kaunter Pembayaran 1"
  zone            String?       // Cth: "Zon A", "Tingkat 1"
  status          CounterStatus @default(OPEN)
  assignedUserId  String?       @map("assigned_user_id")
  assignedUser    User?         @relation("CounterStaff", fields: [assignedUserId], references: [id], onDelete: SetNull)
  currentTicketId String?       @map("current_ticket_id")
  priorityOrder   String?       @map("priority_order") // Cth: "A,B,C"
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  schedules       StaffSchedule[]

  @@index([branchId])
  @@map("counters")
}

model StaffSchedule {
  id          String    @id @default(uuid())
  branchId    String    @map("branch_id")
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counterId   String    @map("counter_id")
  counter     Counter   @relation(fields: [counterId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([branchId])
  @@index([counterId])
  @@index([userId])
  @@map("staff_schedules")
}

// -----------------------------------------------------------------------------
// 5. PERANTI PAPARAN TV & KIOSK
// -----------------------------------------------------------------------------

model Device {
  id             String    @id @default(uuid())
  branchId       String?   @map("branch_id")
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deviceName     String    @map("device_name") // Cth: "TV Ruang Menunggu Utama"
  deviceUid      String    @unique @map("device_uid") // Hardware UUID / Browser Token
  deviceType     String    @default("TV_DISPLAY") @map("device_type") // TV_DISPLAY, KIOSK_PRINTER, TABLET
  pairingCode    String?   @map("pairing_code") // Kod 6-digit sementara
  pairingExpires DateTime? @map("pairing_expires")
  isPaired       Boolean   @default(false) @map("is_paired")
  appVersion     String?   @map("app_version")
  ipAddress      String?   @map("ip_address")
  lastHeartbeat  DateTime  @default(now()) @map("last_heartbeat")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("devices")
}

// -----------------------------------------------------------------------------
// 6. REKOD TIKET GILIRAN (TERPADU & BERINDEKS)
// -----------------------------------------------------------------------------

model Ticket {
  id                     String          @id @default(uuid())
  tenantId               String          @map("tenant_id")
  branchId               String          @map("branch_id")
  branch                 Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId             String          @map("category_id")
  category               ServiceCategory @relation(fields: [categoryId], references: [id])
  ticketNo               String          @map("ticket_no") // Cth: "A1002"
  seqNumber              Int             @map("seq_number") // 1002
  phoneNo                String?         @map("phone_no") // Untuk notifikasi WhatsApp/SMS
  customerName           String?         @map("customer_name")
  status                 TicketStatus    @default(WAITING)
  counterNo              String?         @map("counter_no")
  calledByUserId         String?         @map("called_by_user_id")
  callCount              Int             @default(0) @map("call_count")
  requestType            String          @default("QR_WEB") @map("request_type") // QR_WEB, KIOSK, APP, MANUAL
  notes                  String?         @db.Text
  calledAt               DateTime?       @map("called_at")
  servedAt               DateTime?       @map("served_at")
  completedAt            DateTime?       @map("completed_at")
  cancelledAt            DateTime?       @map("cancelled_at")
  waitingDurationSeconds Int?            @map("waiting_duration_seconds")
  servingDurationSeconds Int?            @map("serving_duration_seconds")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  feedback               Feedback?

  @@index([tenantId, branchId, createdAt])
  @@index([branchId, status])
  @@index([createdAt])
  @@map("tickets")
}

// -----------------------------------------------------------------------------
// 8. TEMUJANJI MAYA (APPOINTMENTS)
// -----------------------------------------------------------------------------

model Appointment {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  branchId        String          @map("branch_id")
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId      String          @map("category_id")
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  appointmentDate DateTime        @map("appointment_date") @db.Date
  timeSlot        String          @map("time_slot") // Cth: "10:30"
  customerName    String          @map("customer_name")
  customerEmail   String?         @map("customer_email")
  customerPhone   String          @map("customer_phone")
  status          String          @default("CONFIRMED") // CONFIRMED, CHECKED_IN, COMPLETED, CANCELLED
  ticketId        String?         @map("ticket_id")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([branchId, appointmentDate])
  @@index([customerPhone])
  @@map("appointments")
}

// -----------------------------------------------------------------------------
// 9. AUDIT LOG & KESELAMATAN
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // Cth: "USER_LOGIN", "CALL_NEXT", "PAIR_DEVICE"
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  status     String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 10. MAKLUM BALAS & PENARAFAN KEPUASAN (CSAT)
// -----------------------------------------------------------------------------

model Feedback {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  branchId     String   @map("branch_id")
  ticketId     String   @unique @map("ticket_id")
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  counterNo    String?  @map("counter_no")
  staffUserId  String?  @map("staff_user_id")
  rating       Int      @default(5) // 1 hingga 5 Bintang
  tags         Json?    // Cth: ["Layanan Pantas", "Staf Mesra"]
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, branchId])
  @@index([staffUserId])
  @@index([rating])
  @@map("feedbacks")
}

// -----------------------------------------------------------------------------
// 11. TRANSAKSI PEMBAYARAN & INVOIS LANGGANAN SAAS (FASA 17)
// -----------------------------------------------------------------------------

model PaymentTransaction {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId  String?       @map("subscription_id")
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNo       String        @unique @map("invoice_no") // Cth: "INV-2026-0001"
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("MYR")
  planType        String        @map("plan_type") // STARTER, PRO, ENTERPRISE
  billingCycle    String        @default("MONTHLY") @map("billing_cycle") // MONTHLY, YEARLY
  paymentMethod   String        @default("FPX") @map("payment_method") // FPX, CARD, DUITNOW_QR, SANDBOX
  gatewayProvider String        @default("SIMULATOR") @map("gateway_provider") // TOYYIBPAY, BILLPLZ, STRIPE, SIMULATOR
  gatewayRef      String?       @map("gateway_ref")
  billCode        String?       @map("bill_code")
  status          PaymentStatus @default(PENDING)
  receiptUrl      String?       @map("receipt_url")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("payment_transactions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}



