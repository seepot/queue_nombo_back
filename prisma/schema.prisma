model Tiket01 {
  id                   Int       @id @default(autoincrement())
  transid              String?   @db.VarChar(50)
  noTiket              Int?      @map("no_tiket")
  noSiri               Int       @map("no_siri")
  tarikh               DateTime?
  kaunter              Int?
  cawangan             String?   @db.VarChar(20)
  kumpulanPerkhidmatan Int?      @map("kumpulan_perkhidmatan")
  playerId             String?   @map("player_id") @db.VarChar(100)
  createDate           DateTime? @map("create_date")
  callDate             DateTime? @map("call_date")
  transferDate         DateTime? @map("transfer_date")
  endDate              DateTime? @map("end_date")
  cancelDate           DateTime? @map("cancel_date")
  activeDate           DateTime? @map("active_date")
  requestBy            Int?      @default(1) @map("request_by")
  catatan              String?   @db.Text
  statusTiket          Int?      @default(0) @map("status_tiket")
  batalOleh            Int       @default(0) @map("batal_oleh")
  ip                   String?   @db.VarChar(100)
  bilanganPanggil      Int?      @default(0) @map("bilangan_panggil")
  transferFrom         Int?      @default(0) @map("transfer_from")
  masaMenunggu         DateTime? @map("masa_menunggu") @db.Time
  masaLayanan          DateTime? @map("masa_layanan") @db.Time
  jumlahMasa           DateTime? @map("jumlah_masa") @db.Time
  updateDate           DateTime  @default(now()) @map("update_date")
  sesi                 Int
  perkhidmatanKhas     String?   @map("perkhidmatan_khas") @db.VarChar(5)
  jenisTiket           Int?      @map("jenis_tiket")
  uuid                 String?   @db.VarChar(100)

  @@unique([noSiri, id], map: "tiket_01_no_siri")
  @@unique([noTiket, id], map: "tiket_01_no_tiket")
  @@unique([kaunter, id], map: "tiket_01_kaunter")
  @@unique([kumpulanPerkhidmatan, id], map: "tiket_01_kumpulan_perkhidmatan")
  @@unique([cawangan, id], map: "tiket_01_cawangan")
  @@map("tiket_01")
}

model Tiket02 {
  id                   Int       @id @default(autoincrement())
  transid              String?   @db.VarChar(50)
  noTiket              Int?      @map("no_tiket")
  noSiri               Int       @map("no_siri")
  tarikh               DateTime?
  kaunter              Int?
  cawangan             String?   @db.VarChar(20)
  kumpulanPerkhidmatan Int?      @map("kumpulan_perkhidmatan")
  playerId             String?   @map("player_id") @db.VarChar(100)
  createDate           DateTime? @map("create_date")
  callDate             DateTime? @map("call_date")
  transferDate         DateTime? @map("transfer_date")
  endDate              DateTime? @map("end_date")
  cancelDate           DateTime? @map("cancel_date")
