datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cawangan {
  id             Int       @id @default(autoincrement())
  idCawangan     String?   @map("id_cawangan") @db.VarChar(20)
  namaCawangan   String    @map("nama_cawangan") @db.VarChar(200)
  alamat1        String?   @db.VarChar(255)
  alamat2        String?   @db.VarChar(255)
  alamat3        String?   @db.VarChar(255)
  alamat4        String?   @db.VarChar(200)
  noTelefon      String?   @map("no_telefon") @db.VarChar(20)
  noFaks         String?   @map("no_faks") @db.VarChar(20)
  negeri         String?   @db.VarChar(10)
  daerah         String?   @db.VarChar(10)
  bilKaunter     Int?      @map("bil_kaunter")
  playerId       String?   @map("player_id") @db.VarChar(200)
  createDate     DateTime? @map("create_date")
  latitud        String?   @db.VarChar(50)
  longitud       String?   @db.VarChar(50)
  updateDate     DateTime? @map("update_date")
  updateBy       String?   @map("update_by") @db.VarChar(20)
  selaMasa       Int?      @map("sela_masa")
  flag           String?   @db.VarChar(5)
  jenisLimit     Int?      @map("jenis_limit") // 1-cawangan; 2-perkhidmatan
  tempohMulaScan Int?      @map("tempoh_mula_scan")
  statusEq       Int?      @default(0) @map("status_eq")
  radius         Int?
  kodQR          String?   @db.VarChar(200)
  tarikhJana     DateTime? @map("tarikh_jana")
  namaQr         String?   @map("nama_qr") @db.VarChar(250)
  gambarQr       String?   @map("gambar_qr") @db.Text

  @@map("cawangan")
}

model CutiUmum {
  id          Int       @id @default(autoincrement())
  cawangan    String?   @db.VarChar(20)
  tarikh1     DateTime? @map("tarikh_1") @db.Date
  statusAktif Int       @default(1) @map("status_aktif")
  createDate  DateTime  @default(now()) @map("create_date")
  keterangan  String?   @db.VarChar(200)
  negeri      String?   @db.VarChar(10)
  updateBy    String?   @map("updateby") @db.VarChar(20)
  updateDate  DateTime? @map("updatedate")

  @@map("cuti_umum")
}

model HadPelanggan {
  id                   Int     @id @default(autoincrement())
  cawangan             String  @db.VarChar(20)
  bahagian             String? @db.VarChar(20)
  kumpulanPerkhidmatan String? @map("kumpulan_perkhidmatan") @db.VarChar(20)
  bilanganPelanggan    Int     @default(0) @map("bilangan_pelanggan")
  statusAktif          Int     @default(1) @map("status_aktif")
  hadPelanggan1        Int     @default(0) @map("had_pelanggan1")
  hadPelanggan2        Int     @default(0) @map("had_pelanggan2")
  hadPelanggan3        Int     @default(0) @map("had_pelanggan3")
  jenisLimit           Int?    @default(1) @map("jenis_limit") // 1-cawangan; 2-perkhidmatan
  tempohMulaScan       Int     @default(0) @map("tempoh_mula_scan")

  @@map("had_pelanggan")
}

model HadTemujanji {
  id           Int     @id @default(autoincrement())
  cawangan     String? @db.VarChar(10)
  bilTemujanji Int?    @map("bil_temujanji")
  bilPlayerId  Int?    @map("bil_player_id")

  @@map("had_temujanji")
}

model HariCuti {
  id         Int      @id @default(autoincrement())
  cawangan   String?  @db.VarChar(20)
  namaHari   String?  @map("nama_hari") @db.VarChar(3)
  createDate DateTime @default(now()) @updatedAt @map("create_date")

  @@map("hari_cuti")
}

model JadualTugasan {
  id          Int       @id @default(autoincrement())
  nokp        String?   @db.VarChar(20)
  idKaunter   Int?      @map("id_kaunter")
  idCawangan  String?   @map("id_cawangan") @db.VarChar(10)
  tarikhMula  DateTime? @map("tarikh_mula") @db.Date
  tarikhTamat DateTime? @map("tarikh_tamat") @db.Date
  statusAktif Int?      @default(1) @map("status_aktif")
  createDate  DateTime? @map("create_date")
  updateDate  DateTime  @default(now()) @map("update_date")

  @@map("jadual_tugasan")
}

model Kaunter {
  id                     Int       @id @default(autoincrement())
  noKaunter              String?   @map("no_kaunter") @db.VarChar(11)
  namaKaunter            String?   @map("nama_kaunter") @db.VarChar(100)
  idPerkhidmatanKumpulan Int?      @map("id_perkhidmatan_kumpulan")
  idCawangan             String?   @map("id_cawangan") @db.VarChar(20)
  noSiri                 Int?      @map("no_siri")
  susunanKeutamaan       String?   @map("susunan_keutamaan") @db.VarChar(35)
  idPengguna             String?   @map("id_pengguna") @db.VarChar(11)
  transid                String?   @db.VarChar(20)
  noTiket                Int?      @map("no_tiket")
  masaPanggil            DateTime? @map("masa_panggil")
  masaSelesai            DateTime? @map("masa_selesai")
  masaBatal              DateTime? @map("masa_batal")
  bilanganPelanggan      Int?      @map("bilangan_pelanggan")
  masaMenunggu           DateTime? @map("masa_menunggu") @db.Time
  waktuMula              DateTime? @map("waktu_mula")
  zon                    String?   @db.VarChar(25)

  @@map("kaunter")
}

model KaunterStat {
  id                    Int       @id @default(autoincrement())
  cawangan              String?   @db.VarChar(20)
  tarikh                DateTime? @db.Date
  kaunter               String?   @db.VarChar(10)
  bilTiket              Int?      @map("bil_tiket")
  bilSelesai            Int?      @map("bil_selesai")
  bilBatal              Int?      @map("bil_batal")
  bilLain               Int?      @map("bil_lain")
  batalCust             Int?      @map("batal_cust")
  batalKaunter          Int?      @map("batal_kaunter")
  purataMasaMenunggu    DateTime? @map("purata_masa_menunggu") @db.Time
  purataMasaLayanan     DateTime? @map("purata_masa_layanan") @db.Time
  masaMenungguTerlama   DateTime? @map("masa_menunggu_terlama") @db.Time
  masaLayananTerlama    DateTime? @map("masa_layanan_terlama") @db.Time
  jumlahMasaKeseluruhan DateTime? @map("jumlah_masa_keseluruhan") @db.Time

  @@index([cawangan])
  @@index([tarikh])
  @@map("kaunter_stat")
}

model KumpulanPerkhidmatan {
  id             Int       @id @default(autoincrement())
  idPerkhidmatan String?   @map("id_perkhidmatan") @db.Text
  idCawangan     String?   @map("id_cawangan") @db.VarChar(20)
  keterangan     String?   @db.VarChar(255)
  noSiri         Int       @map("no_siri")
  noTerkini      Int       @map("no_terkini")
  kategori       Int       @default(1)
  ispelbagai     Int?      @default(0)
  createDate     DateTime? @map("create_date")
  status         Int?      @default(1) // 1-aktif; 0-tidak aktif

  @@index([idCawangan])
  @@map("kumpulan_perkhidmatan")
}

model LevelAkses {
  id          Int     @id @default(autoincrement())
  keterangan  String? @db.VarChar(200)
  statusAktif Int?    @default(1) @map("status_aktif")

  @@map("level_akses")
}

model LogJadualTugasan {
  id          Int       @id @default(autoincrement())
  nokp        String?   @db.VarChar(20)
  idKaunter   Int?      @map("id_kaunter")
  idCawangan  String?   @map("id_cawangan") @db.VarChar(10)
  tarikhMula  DateTime? @map("tarikh_mula") @db.Date
  tarikhTamat DateTime? @map("tarikh_tamat") @db.Date
  createDate  DateTime? @map("create_date")
  updateDate  DateTime  @default(now()) @map("update_date")

  @@map("log_jadual_tugasan")
}

model LogTiket {
  id                   Int       @id @default(autoincrement())
  transid              String?   @db.VarChar(50)
  noTiket              Int?      @map("no_tiket")
  noSiri               Int       @map("no_siri")
  tarikh               DateTime?
  kaunter              Int? // kaunter terkini
  cawangan             String?   @db.VarChar(20)
  kumpulanPerkhidmatan Int?      @map("kumpulan_perkhidmatan")
  playerId             String?   @map("player_id") @db.VarChar(100)
  createDate           DateTime? @map("create_date")
  callDate             DateTime? @map("call_date")
  transferDate         DateTime? @map("transfer_date")
  endDate              DateTime? @map("end_date")
  cancelDate           DateTime? @map("cancel_date")
  activeDate           DateTime? @map("active_date")
  requestBy            Int?      @default(1) @map("request_by") // 1-pengguna, 2-kaunter
  catatan              String?   @db.Text
  statusTiket          Int?      @default(0) @map("status_tiket") // 0-baru, 1-dah panggil, 2-panggil semula, 3-transfer, 4-selesai, 5-batal
  batalOleh            Int       @default(0) @map("batal_oleh") // 0-tiada batal, 1-kaunter, 2-pelanggan
  ip                   String?   @db.VarChar(100)
  bilanganPanggil      Int?      @default(0) @map("bilangan_panggil")
  transferFrom         Int?      @default(0) @map("transfer_from")
  masaMenunggu         DateTime? @map("masa_menunggu") @db.Time
  masaLayanan          DateTime? @map("masa_layanan") @db.Time
  jumlahMasa           DateTime? @map("jumlah_masa") @db.Time
  updateDate           DateTime  @default(now()) @map("update_date")
  sesi                 Int
  perkhidmatanKhas     String?   @map("perkhidmatan_khas") @db.VarChar(5)
  jenisTiket           Int?      @map("jenis_tiket") // 1-manual, null-hp
  uuid                 String?   @db.VarChar(100)

  @@unique([noSiri, id], map: "no_siri")
  @@unique([noTiket, id], map: "no_tiket")
  @@unique([kaunter, id], map: "log_tiket_kaunter")
  @@unique([kumpulanPerkhidmatan, id], map: "log_tiket_kumpulan_perkhidmatan")
  @@unique([cawangan, id], map: "log_tiket_cawangan")
  @@index([uuid], map: "idx_uuid")
  @@map("log_tiket")
}

model LogTransaksi {
  id        Int       @id @default(autoincrement())
  ip        String?   @db.VarChar(100)
  device    String?   @db.VarChar(255)
  tarikh    DateTime?
  direction Int? // 1-from device, 2-to device
  module    String?   @db.VarChar(200)
  data      String?   @db.Text

  @@map("log_transaksi")
}

model LogTransaksiMasaMenunggu {
  id        Int       @id @default(autoincrement())
  ip        String?   @db.VarChar(100)
  device    String?   @db.VarChar(255)
  tarikh    DateTime?
  direction Int? // 1-from device, 2-to device
  module    String?   @db.VarChar(200)
  data      String?   @db.Text

  @@map("log_transaksi_masamenunggu")
}

model Pengumuman {
  id       Int      @id @default(autoincrement())
  cawangan String   @db.VarChar(10)
  catatan  String   @db.Text
  trhMula  DateTime @map("trh_mula") @db.Date
  trhTamat DateTime @map("trh_tamat") @db.Date

  @@map("pengumuman")
}

model Peralatan {
  id       Int     @id @default(autoincrement())
  playerId String? @map("player_id") @db.VarChar(200)
  ip       String? @db.VarChar(100)

  @@map("peralatan")
}

model Perkhidmatan {
  id         Int     @id @default(autoincrement())
  keterangan String? @db.VarChar(500)

  @@map("perkhidmatan")
}

model PerkhidmatanStat {
  id                    Int       @id @default(autoincrement())
  cawangan              String?   @db.VarChar(20)
  tarikh                DateTime? @db.Date
  kumpulanPerkhidmatan  String?   @map("kumpulan_perkhidmatan") @db.VarChar(10)
  keterangan            String?   @db.VarChar(200)
  bilTiket              Int?      @map("bil_tiket")
  bilSelesai            Int?      @map("bil_selesai")
  bilBatal              Int?      @map("bil_batal")
  bilLain               Int?      @map("bil_lain")
  batalCust             Int?      @map("batal_cust")
  batalKaunter          Int?      @map("batal_kaunter")
  purataMasaMenunggu    DateTime? @map("purata_masa_menunggu") @db.Time
  purataMasaLayanan     DateTime? @map("purata_masa_layanan") @db.Time
  masaMenungguTerlama   DateTime? @map("masa_menunggu_terlama") @db.Time
  masaLayananTerlama    DateTime? @map("masa_layanan_terlama") @db.Time
  jumlahMasaKeseluruhan DateTime? @map("jumlah_masa_keseluruhan") @db.Time

  @@index([cawangan])
  @@index([tarikh])
  @@map("perkhidmatan_stat")
}

model Ref {
  id         Int     @id @default(autoincrement())
  kod        String  @db.VarChar(20)
  keterangan String  @db.VarChar(255)
  nilai      String? @db.VarChar(100)
  jenis      Int

  @@map("ref")
}

